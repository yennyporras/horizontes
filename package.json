{
  "name": "horizontes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts --mocks\" \"vite\"",
    "dev:api": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "server": "tsx server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx server/seed.ts",
    "sala:reiniciar": "tsx server/reiniciar_sala.ts",
    "simular": "tsx tools/simulador/index.ts",
    "simular:golden": "tsx tools/simulador/index.ts --golden",
    "ensayo": "tsx tools/simulador/index.ts --ensayo",
    "ensayo:golden": "tsx tools/simulador/index.ts --ensayo --golden"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.1.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@fontsource-variable/montserrat": "^5.2.8",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
