# Copia este archivo a deploy/.env.deploy (ignorado por git) y llénalo con los datos de Coolify.
# Nunca subas los valores reales.
COOLIFY_URL=https://coolify.ejemplo.com
COOLIFY_TOKEN=
COOLIFY_APP_STAGING=
COOLIFY_APP_PROD=
# Opcionales: clave inicial del superadmin por ambiente (solo cuenta la primera vez sobre una base vacía).
# Si se dejan vacías, tools/deploy.sh no toca la que ya tenga Coolify.
SUPERADMIN_CLAVE_STAGING=
SUPERADMIN_CLAVE_PROD=
# Opcional: dominio de producción sin https:// (por defecto horizontes.estratek.com.co). Ver docs/DESPLIEGUE.md §6.
# HZ_DOMINIO_PROD=horizontes.com.co
